# NOVA environment configuration — copy to .env and fill in values.
# Never commit .env to version control.

# Application
NOVA_ENV=development
NOVA_LOG_LEVEL=INFO
NOVA_API_HOST=0.0.0.0
NOVA_API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova

# Redis
REDIS_URL=redis://localhost:6379/0

# Config paths (relative to repo root)
NOVA_CONFIG_DIR=config

# Default user (seed)
NOVA_DEFAULT_USER_ID=arth

# Auth (Slice 2A)
NOVA_TOKEN_PEPPER=dev-pepper-change-in-production
NOVA_REQUIRE_DEVICE_TOKEN=true
NOVA_BOOTSTRAP_ADMIN_ENABLED=true
NOVA_BOOTSTRAP_ADMIN_TOKEN=nova_bts_dev_bootstrap

# Provider runtime (local Ollama)
NOVA_OLLAMA_BASE_URL=http://localhost:11434
# Optional explicit model tags (auto-resolved from /api/tags when unset)
# NOVA_OLLAMA_MODEL=qwen2.5:7b
# NOVA_QWEN_MODEL=qwen2.5:7b
# NOVA_DEEPSEEK_MODEL=deepseek-r1
DEVICE_ID=
DEVICE_NAME=
DEVICE_TYPE=macos_worker
CONTROL_PLANE_URL=http://localhost:8000
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEALTH_PORT=9100
WORKER_TOKEN=
WORKER_WS_ENABLED=true
