#!/usr/bin/env python3
"""NOVA Agent OS CLI."""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
os.environ.setdefault("NOVA_ENV", "development")

from nova_core.agent_os.mission import AgentMissionRunner, MissionStore
from nova_core.agent_os.registry import list_agents, list_forge_specialists
from nova_core.agent_os.skills import list_skills
from nova_core.agent_os.workspace import workspace_root
from nova_core.schemas.settings import Settings


def _runner() -> AgentMissionRunner:
    return AgentMissionRunner()


def cmd_status(_: argparse.Namespace) -> int:
    print("NOVA Agent OS v1")
    print(f"Workspace: {workspace_root()}")
    print(f"Missions: {MissionStore().base_dir}")
    return 0


def cmd_agents(_: argparse.Namespace) -> int:
    print("Leadership agents:")
    for agent in list_agents():
        print(f"- {agent.display_name} ({agent.id}): {agent.role}")
    print("\nForge specialists:")
    for agent in list_forge_specialists():
        print(f"- {agent.display_name} ({agent.id})")
    return 0


def cmd_skills(_: argparse.Namespace) -> int:
    for skill in list_skills():
        approval = "approval" if skill.requires_approval else "auto"
        print(f"- {skill.skill_id} [L{int(skill.required_permission_level)} {approval}]")
    return 0


async def _memory_status_async() -> str:
    from nova_core.models.database import get_session, init_db
    from apps.api.services.agent_mission_service import AgentMissionService

    settings = Settings()
    init_db(settings)
    async for session in get_session():
        svc = AgentMissionService(session, settings)
        text = await svc.memory_status_text(settings.nova_default_user_id)
        await session.commit()
        return text
    return "Memory status unavailable."


def cmd_memory_status(_: argparse.Namespace) -> int:
    print(asyncio.run(_memory_status_async()))
    return 0


async def _search_async(query: str) -> str:
    from nova_core.models.database import get_session, init_db
    from apps.api.services.agent_mission_service import AgentMissionService

    settings = Settings()
    init_db(settings)
    async for session in get_session():
        svc = AgentMissionService(session, settings)
        text = await svc.archive_search(settings.nova_default_user_id, query)
        await session.commit()
        return text
    return "Search unavailable."


def cmd_search(args: argparse.Namespace) -> int:
    print(asyncio.run(_search_async(args.query)))
    return 0


def cmd_mission(args: argparse.Namespace) -> int:
    runner = _runner()
    mission = runner.run_mission(
        args.request,
        run_npm=not args.skip_npm,
        clean_workspace=args.clean,
    )
    print(runner.format_cli_output(mission))
    print(f"\nMission ID: {mission.mission_id}")
    return 0 if mission.final_report.get("build_status") != "FAIL" else 1


def cmd_mission_status(args: argparse.Namespace) -> int:
    mission = _runner().store.load(args.mission_id)
    if mission is None:
        print(f"Mission not found: {args.mission_id}")
        return 1
    print(json.dumps(mission.to_dict(), indent=2))
    return 0


def cmd_timeline(args: argparse.Namespace) -> int:
    print(_runner().format_cli_output(_runner().store.load(args.mission_id)))  # type: ignore[arg-type]
    return 0


def cmd_preview(args: argparse.Namespace) -> int:
    mission = _runner().store.load(args.mission_id)
    if mission is None or not mission.preview_url:
        print("Preview URL unavailable.")
        return 1
    print(mission.preview_url)
    return 0


def cmd_approve(args: argparse.Namespace) -> int:
    mission = _runner().approve_deployment(args.mission_id)
    print(f"Approved deployment for {mission.mission_id}")
    return 0


def cmd_deploy(args: argparse.Namespace) -> int:
    mission = _runner().deploy_mission(args.mission_id)
    print(mission.final_report.get("deployment_status", "unknown"))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="nova", description="NOVA Agent OS CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("agents").set_defaults(func=cmd_agents)
    sub.add_parser("skills").set_defaults(func=cmd_skills)
    sub.add_parser("memory-status").set_defaults(func=cmd_memory_status)

    search_p = sub.add_parser("search")
    search_p.add_argument("query")
    search_p.set_defaults(func=cmd_search)

    mission_p = sub.add_parser("mission")
    mission_p.add_argument("request")
    mission_p.add_argument("--skip-npm", action="store_true")
    mission_p.add_argument("--clean", action="store_true", default=True)
    mission_p.set_defaults(func=cmd_mission)

    ms_p = sub.add_parser("mission-status")
    ms_p.add_argument("mission_id")
    ms_p.set_defaults(func=cmd_mission_status)

    tl_p = sub.add_parser("timeline")
    tl_p.add_argument("mission_id")
    tl_p.set_defaults(func=cmd_timeline)

    prev_p = sub.add_parser("preview")
    prev_p.add_argument("mission_id")
    prev_p.set_defaults(func=cmd_preview)

    appr_p = sub.add_parser("approve")
    appr_p.add_argument("mission_id")
    appr_p.set_defaults(func=cmd_approve)

    dep_p = sub.add_parser("deploy")
    dep_p.add_argument("mission_id")
    dep_p.set_defaults(func=cmd_deploy)

    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
