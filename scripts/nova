#!/usr/bin/env python3
"""NOVA Agent OS CLI."""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
os.environ.setdefault("NOVA_ENV", "development")

from apps.api.services.agent_mission_service import normalize_build_app_request
from nova_core.agent_os.mission import AgentMissionRunner, MissionStore
from nova_core.agent_os.registry import list_agents, list_forge_specialists
from nova_core.agent_os.skills import list_skills
from nova_core.agent_os.workspace import workspace_root
from nova_core.schemas.settings import Settings


def _runner() -> AgentMissionRunner:
    return AgentMissionRunner()


def cmd_status(_: argparse.Namespace) -> int:
    settings = Settings()
    print("NOVA Agent OS v1")
    print(f"Workspace: {workspace_root()}")
    print(f"Missions: {MissionStore().base_dir}")
    local_model = settings.nova_local_model or settings.nova_ollama_model or "(auto)"
    print(f"Local model lane: {local_model}")
    if settings.nova_coder_model:
        print(f"Coder model lane: {settings.nova_coder_model}")
    if settings.nova_long_context_model:
        print(f"Long-context model lane: {settings.nova_long_context_model}")
    return 0


def _fetch_installed_models() -> list[str]:
    import httpx

    settings = Settings()
    url = f"{settings.nova_ollama_base_url.rstrip('/')}/api/tags"
    try:
        resp = httpx.get(url, timeout=5.0)
        resp.raise_for_status()
        return [
            str(entry.get("name", ""))
            for entry in resp.json().get("models", [])
            if entry.get("name")
        ]
    except Exception:
        return []


def _lane_status(model: str, installed: list[str]) -> str:
    if not model or model in {"(auto)", "(not set)"}:
        return "configured"
    if model in installed:
        return "installed"
    prefix = model.split(":")[0]
    if any(name.startswith(prefix) for name in installed):
        return "installed"
    return "missing"


def cmd_models(args: argparse.Namespace) -> int:
    settings = Settings()
    installed = _fetch_installed_models()
    if getattr(args, "recommend", False):
        from nova_core.models.lanes import recommend_lanes

        print("Recommended lanes:")
        for lane, model in recommend_lanes(settings).items():
            print(f"- {lane}: {model}")
        return 0
    if getattr(args, "set_lane", None):
        lane = args.set_lane
        model = args.model_name
        env_map = {
            "local_fast": "NOVA_LOCAL_MODEL",
            "local_coder": "NOVA_CODER_MODEL",
            "local_reasoning": "NOVA_REASONING_MODEL",
            "external_coding": "NOVA_FORGE_DEFAULT_ENGINE",
        }
        env_key = env_map.get(lane)
        if not env_key:
            print(f"Unknown lane: {lane}")
            return 1
        print(f"Set {env_key}={model} in your shell or .env")
        return 0
    from nova_core.models.lanes import lane_statuses

    lanes = {
        "local_default": settings.nova_local_model or settings.nova_ollama_model or "(auto)",
        "local_coder": settings.nova_coder_model or "(not set)",
        "local_long_context": settings.nova_long_context_model or "(not set)",
        "local_reasoning": settings.nova_reasoning_model or "(not set)",
        "qwen": settings.nova_qwen_model or "(auto)",
    }
    print("Model lanes:")
    for lane, model in lanes.items():
        print(f"- {lane}: {model} [{_lane_status(model, installed)}]")
    print("\nLane registry:")
    for row in lane_statuses(settings):
        print(
            f"- {row.lane}: configured={row.configured} "
            f"installed={row.installed} recommended={row.recommended}"
        )
    print("\nInstalled Ollama models:")
    if installed:
        for name in installed:
            print(f"- {name}")
    else:
        print("- (none reachable — start Ollama or run: nova pull-model <name>)")
    return 0


def cmd_forge_engines(_: argparse.Namespace) -> int:
    from apps.api.services.forge_engine_service import ForgeEngineService

    for row in ForgeEngineService().engines_status():
        avail = "yes" if row["available"] else "no"
        print(f"- {row['engine_id']} ({row['display_name']}) available={avail}")
        if not row["available"]:
            print(f"  hint: {row['setup_hint'][:120]}...")
    return 0


def cmd_forge_check(_: argparse.Namespace) -> int:
    from apps.api.services.forge_engine_service import ForgeEngineService

    svc = ForgeEngineService()
    for row in svc.engines_status():
        print(f"{row['engine_id']}: {'OK' if row['available'] else 'MISSING'}")
    return 0


def cmd_forge_run(args: argparse.Namespace) -> int:
    from pathlib import Path

    from apps.api.services.forge_engine_service import ForgeEngineService

    project = Path(args.project).expanduser() if args.project else None
    out = ForgeEngineService().run(
        args.task,
        project_path=project,
        engine_id=args.engine or None,
    )
    print(json.dumps(out, indent=2))
    return 0 if out["result"]["success"] else 1


def cmd_forge_set_engine(args: argparse.Namespace) -> int:
    print(f"Set NOVA_FORGE_DEFAULT_ENGINE={args.engine} in your shell or .env")
    return 0


def cmd_voice_status(_: argparse.Namespace) -> int:
    from nova_core.voice.wake_runtime import runtime_status

    st = runtime_status()
    print(f"backend: {st.backend}")
    print(f"openwakeword: {st.openwakeword}")
    print(f"phrase_fallback: {st.phrase_fallback}")
    print(st.setup_hint)
    return 0


def cmd_voice_setup_ow(_: argparse.Namespace) -> int:
    from nova_core.voice.openwakeword_adapter import setup_hint_markdown

    print(setup_hint_markdown())
    print("\nOptional: pip install openwakeword")
    return 0


def cmd_pull_model(args: argparse.Namespace) -> int:
    import subprocess

    print(f"Pulling model: {args.name}")
    result = subprocess.run(["ollama", "pull", args.name], check=False)
    return int(result.returncode)


def cmd_agents(_: argparse.Namespace) -> int:
    print("Leadership agents:")
    for agent in list_agents():
        print(f"- {agent.display_name} ({agent.id}): {agent.role}")
    print("\nForge specialists:")
    for agent in list_forge_specialists():
        print(f"- {agent.display_name} ({agent.id})")
    return 0


def cmd_skills(_: argparse.Namespace) -> int:
    for skill in list_skills():
        approval = "approval" if skill.requires_approval else "auto"
        print(f"- {skill.skill_id} [L{int(skill.required_permission_level)} {approval}]")
    return 0


async def _memory_status_async() -> str:
    from nova_core.models.database import get_session, init_db
    from apps.api.services.agent_mission_service import AgentMissionService

    settings = Settings()
    init_db(settings)
    async for session in get_session():
        svc = AgentMissionService(session, settings)
        text = await svc.memory_status_text(settings.nova_default_user_id)
        await session.commit()
        return text
    return "Memory status unavailable."


def cmd_memory_status(_: argparse.Namespace) -> int:
    print(asyncio.run(_memory_status_async()))
    return 0


async def _search_async(query: str) -> str:
    from nova_core.models.database import get_session, init_db
    from apps.api.services.agent_mission_service import AgentMissionService

    settings = Settings()
    init_db(settings)
    async for session in get_session():
        svc = AgentMissionService(session, settings)
        text = await svc.archive_search(settings.nova_default_user_id, query)
        await session.commit()
        return text
    return "Search unavailable."


def cmd_search(args: argparse.Namespace) -> int:
    print(asyncio.run(_search_async(args.query)))
    return 0


def _run_mission_request(request: str, *, skip_npm: bool, clean: bool, start_preview: bool) -> int:
    runner = _runner()
    try:
        mission = runner.run_mission(
            request,
            run_npm=not skip_npm,
            clean_workspace=clean,
            start_preview=start_preview,
        )
    except Exception as exc:
        print(f"Mission failed: {exc.__class__.__name__}")
        return 1
    print(runner.format_cli_output(mission))
    print(f"\nMission ID: {mission.mission_id}")
    return 0 if mission.final_report.get("build_status") != "FAIL" else 1


def cmd_build_app(args: argparse.Namespace) -> int:
    request = normalize_build_app_request(args.app_name)
    return _run_mission_request(
        request,
        skip_npm=args.skip_npm,
        clean=args.clean,
        start_preview=not args.no_preview,
    )


def cmd_mission(args: argparse.Namespace) -> int:
    return _run_mission_request(
        args.request,
        skip_npm=args.skip_npm,
        clean=args.clean,
        start_preview=not args.no_preview,
    )


def cmd_mission_status(args: argparse.Namespace) -> int:
    mission = _runner().store.load(args.mission_id)
    if mission is None:
        print(f"Mission not found: {args.mission_id}")
        return 1
    if args.json:
        print(json.dumps(mission.to_dict(), indent=2))
    else:
        print(_runner().format_cli_output(mission))
    return 0


def cmd_timeline(args: argparse.Namespace) -> int:
    mission = _runner().store.load(args.mission_id)
    if mission is None:
        print(f"Mission not found: {args.mission_id}")
        return 1
    print(_runner().format_cli_output(mission))
    return 0


def cmd_preview(args: argparse.Namespace) -> int:
    mission = _runner().store.load(args.mission_id)
    if mission is None or not mission.preview_url:
        print("Preview URL unavailable.")
        return 1
    print(mission.preview_url)
    return 0


def cmd_stop_preview(args: argparse.Namespace) -> int:
    stopped = _runner().stop_preview(args.mission_id)
    if stopped:
        print(f"Preview stopped for mission {args.mission_id}")
        return 0
    print("No running preview found for this mission.")
    return 1


def cmd_approve(args: argparse.Namespace) -> int:
    try:
        mission = _runner().approve_deployment(args.mission_id)
    except ValueError as exc:
        print(str(exc))
        return 1
    print(f"Approved deployment for {mission.final_report.get('app_name', mission.mission_id)}")
    return 0


def cmd_deploy(args: argparse.Namespace) -> int:
    try:
        mission = _runner().deploy_mission(args.mission_id)
    except ValueError as exc:
        print(str(exc))
        return 1
    print(mission.final_report.get("deployment_status", "unknown"))
    return 0


def cmd_gmail_status(_: argparse.Namespace) -> int:
    from apps.api.services.gmail_oauth_service import GmailOAuthService

    status = GmailOAuthService(Settings()).status()
    print(f"configured: {'yes' if status.get('configured') else 'no'}")
    print(f"client_configured: {'yes' if status.get('client_configured') else 'no'}")
    if status.get("account_email"):
        print(f"account: {status['account_email']}")
    print("scopes:")
    for scope in status.get("scopes", []):
        print(f"  - {scope}")
    print(f"token_location: {status.get('token_location')}")
    return 0


def cmd_gmail_auth(_: argparse.Namespace) -> int:
    from apps.api.services.gmail_oauth_service import GmailOAuthService

    return GmailOAuthService(Settings()).start_auth_flow()


def cmd_gmail_disconnect(_: argparse.Namespace) -> int:
    from apps.api.services.gmail_oauth_service import GmailOAuthService

    GmailOAuthService(Settings()).disconnect()
    print("Gmail disconnected.")
    return 0


def cmd_gmail_test_draft(args: argparse.Namespace) -> int:
    from apps.api.services.gmail_draft_service import GmailDraftService

    settings = Settings()
    service = GmailDraftService(settings)
    if not service.is_configured():
        print("Gmail is not connected. Run: nova gmail auth")
        return 1
    to = args.to or settings.nova_default_user_id + "@example.com"
    subject = "[NOVA TEST] Draft verification"
    body = "This is a NOVA Gmail test draft. It is safe to delete."
    source, draft_id = service.create_draft(to=to, subject=subject, body=body)
    print(f"created {source} draft: {draft_id}")
    return 0


async def _voice_transcript_once(transcript: str, *, session_id: str | None) -> int:
    from nova_core.voice.pipeline import route_voice_transcript, submit_voice_command

    command, wake = route_voice_transcript(transcript)
    if not command:
        print("No command detected after wake phrase.")
        return 1
    if wake:
        print(f"wake: {wake}")
    print(f"command: {command}")
    data = await submit_voice_command(command, session_id=session_id)
    print(data.get("response", data))
    return 0


def cmd_voice(args: argparse.Namespace) -> int:
    if getattr(args, "voice_command", None) == "status":
        return cmd_voice_status(args)
    if getattr(args, "voice_command", None) == "setup-openwakeword":
        return cmd_voice_setup_ow(args)
    if args.transcript or getattr(args, "simulate", ""):
        text = args.transcript or args.simulate
        return asyncio.run(_voice_transcript_once(text, session_id=args.session_id))
    if getattr(args, "listen", False):
        print("Live mic listen requires openWakeWord — use --simulate for CI.")
        return cmd_voice_status(args)
    print(
        "NOVA voice mode\n"
        "  --transcript 'hey nova build a todo app called voice tasks'\n"
        "  --push-to-talk (stdin lines)\n"
        "  --debug prints wake parsing\n"
    )
    if args.push_to_talk:
        import sys

        for line in sys.stdin:
            text = line.strip()
            if not text:
                continue
            from nova_core.voice.wake_word import parse_wake_command

            if args.debug:
                parsed = parse_wake_command(text)
                print(f"debug wake={parsed.wake_detected} command={parsed.command!r}")
            asyncio.run(_voice_transcript_once(text, session_id=args.session_id))
        return 0
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="nova", description="NOVA Agent OS CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(func=cmd_status)
    models_p = sub.add_parser("models")
    models_p.add_argument("--recommend", action="store_true")
    models_p.add_argument("--set-lane", default=None)
    models_p.add_argument("model_name", nargs="?", default="")
    models_p.set_defaults(func=cmd_models)
    pull_p = sub.add_parser("pull-model")
    pull_p.add_argument("name")
    pull_p.set_defaults(func=cmd_pull_model)
    sub.add_parser("agents").set_defaults(func=cmd_agents)
    sub.add_parser("skills").set_defaults(func=cmd_skills)
    sub.add_parser("memory-status").set_defaults(func=cmd_memory_status)

    search_p = sub.add_parser("search")
    search_p.add_argument("query")
    search_p.set_defaults(func=cmd_search)

    build_p = sub.add_parser("build-app")
    build_p.add_argument("app_name")
    build_p.add_argument("--skip-npm", action="store_true")
    build_p.add_argument("--clean", action="store_true", default=True)
    build_p.add_argument("--no-preview", action="store_true")
    build_p.set_defaults(func=cmd_build_app)

    mission_p = sub.add_parser("mission")
    mission_p.add_argument("request")
    mission_p.add_argument("--skip-npm", action="store_true")
    mission_p.add_argument("--clean", action="store_true", default=True)
    mission_p.add_argument("--no-preview", action="store_true")
    mission_p.set_defaults(func=cmd_mission)

    ms_p = sub.add_parser("mission-status")
    ms_p.add_argument("mission_id")
    ms_p.add_argument("--json", action="store_true")
    ms_p.set_defaults(func=cmd_mission_status)

    tl_p = sub.add_parser("timeline")
    tl_p.add_argument("mission_id")
    tl_p.set_defaults(func=cmd_timeline)

    prev_p = sub.add_parser("preview")
    prev_p.add_argument("mission_id")
    prev_p.set_defaults(func=cmd_preview)

    stop_p = sub.add_parser("stop-preview")
    stop_p.add_argument("mission_id")
    stop_p.set_defaults(func=cmd_stop_preview)

    appr_p = sub.add_parser("approve")
    appr_p.add_argument("mission_id")
    appr_p.set_defaults(func=cmd_approve)

    dep_p = sub.add_parser("deploy")
    dep_p.add_argument("mission_id")
    dep_p.set_defaults(func=cmd_deploy)

    gmail_p = sub.add_parser("gmail")
    gmail_sub = gmail_p.add_subparsers(dest="gmail_command", required=True)
    gmail_sub.add_parser("status").set_defaults(func=cmd_gmail_status)
    gmail_sub.add_parser("auth").set_defaults(func=cmd_gmail_auth)
    gmail_sub.add_parser("disconnect").set_defaults(func=cmd_gmail_disconnect)
    test_draft_p = gmail_sub.add_parser("test-draft")
    test_draft_p.add_argument("--to", default="")
    test_draft_p.set_defaults(func=cmd_gmail_test_draft)

    voice_p = sub.add_parser("voice")
    voice_sub = voice_p.add_subparsers(dest="voice_command")
    voice_sub.add_parser("status").set_defaults(func=cmd_voice_status)
    voice_sub.add_parser("setup-openwakeword").set_defaults(func=cmd_voice_setup_ow)
    voice_p.add_argument("--debug", action="store_true")
    voice_p.add_argument("--wake-word", default="nova")
    voice_p.add_argument("--push-to-talk", action="store_true")
    voice_p.add_argument("--listen", action="store_true")
    voice_p.add_argument("--transcript", default="")
    voice_p.add_argument("--simulate", default="")
    voice_p.add_argument("--session-id", default=None)
    voice_p.set_defaults(func=cmd_voice, voice_command=None)

    forge_p = sub.add_parser("forge")
    forge_sub = forge_p.add_subparsers(dest="forge_command", required=True)
    forge_sub.add_parser("engines").set_defaults(func=cmd_forge_engines)
    forge_sub.add_parser("check").set_defaults(func=cmd_forge_check)
    forge_run = forge_sub.add_parser("run")
    forge_run.add_argument("task")
    forge_run.add_argument("--project", default="")
    forge_run.add_argument("--engine", default="")
    forge_run.set_defaults(func=cmd_forge_run)
    forge_set = forge_sub.add_parser("set-engine")
    forge_set.add_argument("engine")
    forge_set.set_defaults(func=cmd_forge_set_engine)

    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
